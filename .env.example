# Studio BaaS —— 可选环境变量（复制为 .env 或直接 export）

# 服务端端口（开发模式下控制台在 5173，API 在 5174）
PORT=5174

# ---------------- AI ----------------
# 任选一个服务商；都兼容 OpenAI 的 /chat/completions + tools 协议
#   deepseek | openai | ollama | custom
AI_PROVIDER=deepseek
# 不配置密钥则进入 Demo 模式：本地规则引擎仍会真实调用工具
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# 覆盖 provider 默认值（走网关、或换模型时用）
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com
# Ollama 示例（本地免密钥）：
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5-coder
# AI_BASE_URL=http://127.0.0.1:11434/v1
# 写操作审批：设为 off 会跳过人工确认（不建议，仅内部脚本用）
# AI_APPROVAL=off

# 自定义域名的校验方式：simulate（默认，本地无 DNS 也能演示）| strict（真实 dns.resolveTxt）
DOMAIN_VERIFY_MODE=simulate

# GitHub 集成：simulate（默认，不访问外网，提交/部署/验签逻辑真实）| live（调用 GitHub REST API）
GIT_MODE=simulate

# 函数执行隔离：留空即 worker 线程（默认）；设为 vm 会退回同进程沙箱（仅排障用）
# FUNCTION_ISOLATION=vm

# 「View as role」演示开关：0 表示完全忽略 x-studio-act-as（公网部署建议设 0）
# STUDIO_ALLOW_ACT_AS=0
